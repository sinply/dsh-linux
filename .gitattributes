# Normalize line endings in the repository, and keep executable scripts usable.
#
# The pipeline scripts run inside WSL/Linux: a CRLF shell script fails with
# `bash: $'\r': command not found`. Force LF for shell scripts regardless of the
# build machine's core.autocrlf setting.
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf

# Artifacts and build outputs
*.tar.gz binary
*.tgz binary
*.vsix binary
